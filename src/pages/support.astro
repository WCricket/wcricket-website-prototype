---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Support – Wcricket"
  description="Get help with Wcricket or report a problem."
  solidHeader
  currentPage="support"
  bodyClass="inner-page"
>
  <main id="main" class="inner-main">
    <section class="inner-hero">
      <div class="shell narrow">
        <p class="eyebrow">Help and contact</p>
        <h1>Wcricket Support</h1>
        <p class="lede">Need help with Wcricket or want to report a problem? Contact the Wcricket team and include as much detail as possible about what happened, including your device and app version where relevant.</p>
        <div class="notice"><strong>Launch note:</strong> the support email address still needs to be confirmed before this page is published.</div>
      </div>
    </section>
  </main>
</BaseLayout>
