---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
---
<BaseLayout
  title="Wcricket – Play your innings. One ball at a time."
  description="A different kind of cricket game where word-game skill, cricket decisions and chance combine to create an innings that develops day by day."
>
  <main id="main">
    <section class="hero" id="top">
      <div class="hero-art" aria-hidden="true">
        <img src="/images/01_hero_high_catch_illustrated.png" alt="" width="1448" height="1086" />
      </div>
      <div class="shell hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">A different kind of cricket game</p>
          <h1>Play your innings.<br />One ball at a time.</h1>
          <p class="lede">A different kind of cricket game where word-game skill, cricket decisions and chance combine to create an innings that develops day by day — with moments worth sharing along the way.</p>
          <a class="button button-dark" href="#download">Coming soon on the App Store</a>
        </div>
      </div>
    </section>

    <section class="section section-accordion" id="experience">
      <div class="shell">
        <div class="accordion-intro reveal">
          <p class="eyebrow">How Wcricket works</p>
          <h2>Start with a word puzzle. Build a cricket innings.</h2>
          <p>Each day begins with the result from your daily word challenge. Wcricket turns that result into the next passage of a continuing cricket innings — with cricket rules, decisions and chance shaping what happens next.</p>
        </div>

        <div class="story-stack reveal" data-story-stack>
          <StoryCard
            id="card-gameplay"
            number="01"
            eyebrow="Start here"
            title="Your daily word-puzzle result becomes cricket"
            open
            variant={1}
          >
            <div class="story-panel-grid">
              <div class="device-frame story-device">
                <img src="/images/02_gameplay_word_result_commentary.png" alt="Wcricket gameplay screen showing a word result, cricket commentary and match imagery" width="941" height="2048" loading="lazy" />
              </div>
              <div class="copy-block word-explainer">
                <p class="eyebrow">The idea in one move</p>
                <h3>Your word result becomes the next passage of your innings</h3>
                <p>Finish your daily word challenge and enter how many attempts it took. Wcricket uses that result, together with cricket rules, decisions and chance, to create what happens next on the field.</p>
                <div class="aha-flow" aria-label="Example of a word-puzzle result becoming part of a cricket innings">
                  <div class="aha-step"><span class="aha-label">Your result</span><strong>3 attempts</strong></div>
                  <span class="aha-arrow" aria-hidden="true">→</span>
                  <div class="aha-step"><span class="aha-label">Wcricket</span><strong>cricket event</strong></div>
                  <span class="aha-arrow" aria-hidden="true">→</span>
                  <div class="aha-step"><span class="aha-label">Your innings</span><strong>score + story move on</strong></div>
                </div>
                <p class="micro-note">Illustrative flow: the word result is an input to Wcricket, not a fixed one-to-one conversion into a particular cricket outcome.</p>
              </div>
            </div>
          </StoryCard>

          <StoryCard id="card-scorecard" number="02" eyebrow="Your scorecard" title="Build an innings" variant={2}>
            <div class="story-panel-grid story-panel-grid-reverse">
              <div class="device-frame story-device">
                <img src="/images/03_scorecard.png" alt="Wcricket scorecard showing batting and bowling figures from a developing innings" width="941" height="2048" loading="lazy" />
              </div>
              <div class="copy-block">
                <p class="eyebrow">Your scorecard</p>
                <h3>Build an innings</h3>
                <p>Scores, wickets, partnerships and bowling figures accumulate over time. The scorecard records the innings you have created.</p>
              </div>
            </div>
          </StoryCard>

          <StoryCard id="teams" number="03" eyebrow="Choose your cricket" title="Play across teams and eras" variant={3}>
            <div class="story-panel-grid">
              <div class="device-frame story-device">
                <img src="/images/07_team_selection_OPTIONAL.png" alt="Wcricket team selection screen showing choices of cricket teams and eras" loading="lazy" />
              </div>
              <div class="copy-block">
                <p class="eyebrow">Teams &amp; eras</p>
                <h3>Choose your cricket</h3>
                <p>Play with men's or women's teams, choose from Test-playing nations, and select from current or historic player eras.</p>
                <div class="body-lozenge-group" aria-label="Team selection options">
                  <span class="highlight-lozenge">Men's &amp; women's teams</span>
                  <span class="highlight-lozenge">Test-playing nations</span>
                  <span class="highlight-lozenge">Current &amp; historic eras</span>
                </div>
              </div>
            </div>
          </StoryCard>

          <StoryCard id="card-drs" number="04" eyebrow="Unpredictable moments" title="Cricket has drama" variant={4}>
            <div class="story-panel-grid">
              <div class="device-frame story-device">
                <img src="/images/04_drs_not_out.png" alt="Wcricket DRS review screen showing a not out decision" width="941" height="2048" loading="lazy" />
              </div>
              <div class="copy-block">
                <p class="eyebrow">Unpredictable moments</p>
                <h3>Cricket has drama</h3>
                <p>Reviews, wickets and changing match situations give the innings its tension. Decisions and chance keep the story moving.</p>
              </div>
            </div>
          </StoryCard>

          <StoryCard id="story" number="05" eyebrow="Memorable moments" title="Every innings has a story" variant={5}>
            <div class="story-panel-grid story-panel-grid-reverse story-grid-wide-image">
              <div class="story-image story-device">
                <img src="/images/07_partnership_100_milestone.png" alt="Wcricket screen celebrating a 100-run partnership milestone between Duckett and Gay" width="941" height="2048" loading="lazy" />
              </div>
              <div class="copy-block">
                <p class="eyebrow">Memorable moments</p>
                <h3>Every innings has a story</h3>
                <p>Partnerships, milestones and turning points create an unfolding narrative. Wcricket records the moments that turn a score into an innings.</p>
                <p class="micro-note">Milestones, reviews, scorecards and turning points become moments you can revisit — or share.</p>
              </div>
            </div>
          </StoryCard>

          <StoryCard id="reel" number="06" eyebrow="Highlights &amp; sharing" title="Relive the innings" variant={6}>
            <div class="story-panel-grid reel-grid">
              <div class="reel-preview">
                <div class="teaser-video-wrap">
                  <video
                    class="teaser-video"
                    controls
                    playsinline
                    preload="auto"
                    poster="/media/reel_teaser_opening.jpg"
                    aria-label="Wcricket highlight reel teaser"
                  >
                    <source src="/media/reel_teaser_v12.mp4" type="video/mp4" />
                    Your browser does not support HTML5 video.
                  </video>
                </div>

                <div class="reel-lozenges" aria-label="Highlight reel features">
                  <span class="highlight-lozenge"><span class="lozenge-medal" aria-hidden="true"></span>Highlight Ribbon</span>
                  <span class="highlight-lozenge"><span class="lozenge-medal" aria-hidden="true"></span>Match-state analysis</span>
                  <span class="highlight-lozenge"><span class="lozenge-medal" aria-hidden="true"></span>Shareable moments</span>
                </div>

                <figure class="ribbon-reference">
                  <img src="/images/09_reel_card_reference.jpg" alt="Wcricket Highlight Ribbon showing passage cards, elegant highlight lozenges and match-state analysis" loading="lazy" />
                  <figcaption>Highlight Ribbon view</figcaption>
                </figure>
              </div>

              <div class="copy-block reel-copy">
                <p class="eyebrow">Built to share the good bits</p>
                <h3>Your innings, cut to the moments that mattered</h3>
                <p>Wcricket gathers wickets, reviews, partnerships, milestones and shifts in the match state into a highlight reel — ready to watch back, keep or share.</p>
                <div class="body-lozenge-group" aria-label="Examples of reel highlights">
                  <span class="highlight-lozenge"><span class="lozenge-medal" aria-hidden="true"></span>Duckett 50</span>
                  <span class="highlight-lozenge"><span class="lozenge-medal" aria-hidden="true"></span>Partnership 50</span>
                  <span class="highlight-lozenge"><span class="lozenge-medal" aria-hidden="true"></span>Batting dominance</span>
                </div>
                <p class="micro-note">The teaser uses the current reel work in progress; the Highlight Ribbon shows the same lozenge-led visual language used in the app.</p>
              </div>
            </div>
          </StoryCard>

          <StoryCard id="character" number="07" eyebrow="On This Day" title="Cricket with character" variant={7}>
            <div class="story-panel-grid">
              <div class="character-card story-device">
                <img src="/images/06_on_this_day.png" alt="Wcricket On This Day screen celebrating a story from cricket history" width="941" height="2048" loading="lazy" />
              </div>
              <div class="copy-block">
                <p class="eyebrow">On This Day</p>
                <h3>Cricket with character</h3>
                <p>Wcricket also celebrates the game beyond the current innings, with stories and moments from cricket's past.</p>
              </div>
            </div>
          </StoryCard>
        </div>
      </div>
    </section>

    <section class="final-cta" id="download">
      <div class="final-cta-art" aria-hidden="true">
        <img src="/images/01_hero_high_catch_illustrated.png" alt="" width="1448" height="1086" loading="lazy" />
      </div>
      <div class="shell final-cta-inner reveal">
        <p class="eyebrow eyebrow-light">Your next innings</p>
        <h2>Ready to start your innings?</h2>
        <p>Play it today. Build the story. Share the moments.</p>
        <span class="button button-light" aria-disabled="true">Coming soon on the App Store</span>
      </div>
    </section>
  </main>
</BaseLayout>
