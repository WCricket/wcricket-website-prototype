---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Privacy – Wcricket"
  description="Wcricket privacy information."
  solidHeader
  currentPage="privacy"
  bodyClass="inner-page"
>
  <main id="main" class="inner-main">
    <section class="inner-hero">
      <div class="shell narrow legal-copy">
        <p class="eyebrow">Legal</p>
        <h1>Privacy</h1>
        <div class="notice"><strong>Publication hold:</strong> the implementation pack specifies that the approved Wcricket privacy policy must be published here, but the policy wording itself was not included. Insert the approved policy before launch.</div>
      </div>
    </section>
  </main>
</BaseLayout>
